{
  "$schema": "https://json.schemastore.org/tsconfig",

  "include": ["src/**/*"],

  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "target": "es2021",
    "module": "node16",
    "moduleResolution": "node16",

    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,

    "paths": {
      "@branding/strings.json": ["./src/branding-strings-stub.json"]
    }
  }
}
